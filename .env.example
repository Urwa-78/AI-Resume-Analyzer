# =============================================================================
# AI Resume Analyzer — Environment Configuration
# Copy this file to ".env" and fill in your real values.
# Never commit your actual ".env" file to version control.
# =============================================================================

# ---- OpenRouter AI (required for AI analysis + chatbot features) ----
# Get a free/paid key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Any model available on OpenRouter, e.g.:
#   openai/gpt-4o-mini
#   google/gemini-2.0-flash-001
#   anthropic/claude-3.5-haiku
#   meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional, recommended by OpenRouter for analytics/rate-limit identification
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_SITE_NAME=AI Resume Analyzer

# ---- Database (optional) ----
# If left empty, the app automatically falls back to a local SQLite
# database at data/local_fallback.db so it still runs end-to-end.
# Example Postgres URL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/resume_analyzer
DATABASE_URL=
